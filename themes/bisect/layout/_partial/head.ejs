<%
  let pageTitle = config.title;
  if (is_home()) pageTitle = config.title + (config.subtitle ? ' · ' + config.subtitle : '');
  else if (is_archive()) pageTitle = __('archive.title') + ' | ' + config.title;
  else if (is_category()) pageTitle = page.category + ' | ' + config.title;
  else if (is_tag()) pageTitle = '#' + page.tag + ' | ' + config.title;
  else if (page.title) pageTitle = page.title + ' | ' + config.title;
  const desc = page.description || (is_post() && page.excerpt ? strip_html(page.excerpt).replace(/\s+/g, ' ').slice(0, 140) : config.description);
  const fonts = theme.fonts || {};
  const cjk = fonts.cjk || 'google';
  const host = (fonts.host || 'https://fonts.googleapis.com').replace(/\/$/, '');
  const feed = bs_feed();
  const canonicalUrl = full_url_for(page.path).replace(/index\.html$/, '');
  const siteName = config.title || '';
  const authorName = config.author || siteName;
  const isNoIndex = page.noindex === true;
  const cover = is_post() ? bs_cover(page) : '';
  const imageUrl = cover ? (cover.match(/^https?:\/\//) ? cover : full_url_for(cover)) : '';
  const baseDescription = desc || config.description || siteName;

  let schemaData;
  if (is_post()) {
    schemaData = {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: page.title || siteName,
      description: baseDescription,
      mainEntityOfPage: canonicalUrl,
      url: canonicalUrl,
      datePublished: date_xml(page.date),
      dateModified: date_xml(page.updated || page.date),
      author: {
        '@type': 'Person',
        name: authorName
      },
      publisher: {
        '@type': 'Organization',
        name: siteName
      }
    };
    if (imageUrl) schemaData.image = [imageUrl];
  } else {
    schemaData = {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: config.url || canonicalUrl,
      description: baseDescription
    };
  }
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= pageTitle %></title>
<meta name="description" content="<%= desc %>">
<meta name="google-site-verification" content="D1JsU6X31u_7uXr7031aFz8UubO8DDIj6flZzdMG9e4" />
<meta name="robots" content="<%= isNoIndex ? 'noindex, nofollow, noarchive' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' %>">
<% if (config.keywords) { %><meta name="keywords" content="<%= config.keywords %>"><% } %>
<% if (config.author) { %><meta name="author" content="<%= config.author %>"><% } %>
<meta name="twitter:creator" content="@NarainKrishna">
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f7f8">
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a">
<meta name="color-scheme" content="light dark">
<link rel="canonical" href="<%= canonicalUrl %>">
<%- open_graph({ twitter_card: 'summary_large_image', description: desc }) %>
<script type="application/ld+json"><%- JSON.stringify(schemaData) %></script>
<script>
  (function () {
    try {
      var t = localStorage.getItem('bs-theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    } catch (e) {}
    document.documentElement.classList.add('js');
    addEventListener('pagereveal', function (e) {
      if (e.viewTransition) { e.viewTransition.ready.catch(function () {}); e.viewTransition.finished.catch(function () {}); }
    });
  })();
</script>
<link rel="preload" href="<%- url_for('fonts/archivo-latin.woff2') %>" as="font" type="font/woff2" crossorigin>
<% if (cjk === 'google') { %>
<% if (/googleapis\.com/.test(host)) { %><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><% } %>
<link rel="stylesheet" href="<%- host %>/css2?family=Noto+Serif+SC:wght@400..900&family=Noto+Sans+SC:wght@900&display=swap">
<% } else if (cjk === 'local') { %>
<link rel="stylesheet" href="<%- url_for('css/bisect-cjk.css') %>">
<% } %>
<link rel="stylesheet" href="<%- url_for('css/bisect.css') %>?v=red-theme">
<link rel="stylesheet" href="<%- url_for('css/cursor.css') %>">
<% if (feed) { %><link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%- feed %>"><% } %>
<script type="speculationrules">
{"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/*.xml"}}]},"eagerness":"moderate"}]}
</script>
